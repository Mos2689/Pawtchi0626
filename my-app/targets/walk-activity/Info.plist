<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Committed rather than generated. @bacons/apple-targets writes this file
	  only when it is absent, so this is the supported way to add keys its config
	  schema does not cover — here, the bundled brand fonts.

	  NSExtensionPointIdentifier must stay exactly what the plugin would have
	  written for a `widget` target; changing it detaches the extension.
	-->
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.widgetkit-extension</string>
	</dict>
	<!--
	  Plus Jakarta Sans, the face the Walk Memory viewer uses — so a walk looks
	  like the same product on the Lock Screen as it does in the app.

	  This is what the original design handoff asked for. The first build shipped
	  Montserrat and Playfair standing in for it, because adding a family for one
	  surface is what the design-system rule forbids; the app has since adopted
	  Jakarta for the memory surfaces (see the fence in constants/design.ts), so
	  the stand-ins are gone and the handoff is met.

	  The whole target folder is synchronized into the Xcode target, so these
	  .ttf files are already copied as resources; this is what registers them.
	  PawtchiTheme falls back to a weight-matched system font if registration
	  ever fails, so a missing font degrades rather than breaks.
	-->
	<key>UIAppFonts</key>
	<array>
		<string>PlusJakartaSans_200ExtraLight.ttf</string>
		<string>PlusJakartaSans_500Medium.ttf</string>
		<string>PlusJakartaSans_600SemiBold.ttf</string>
		<string>PlusJakartaSans_700Bold.ttf</string>
	</array>
</dict>
</plist>
