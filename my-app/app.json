{
  "expo": {
    "name": "Pawtchi",
    "slug": "pawtchi",
    "version": "1.0.12",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pawtchi",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "owner": "hey_mousami",
    "ios": {
      "bundleIdentifier": "com.heymousami.myapp",
      "buildNumber": "1.0.17",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Pawtchi uses your camera to scan your pet's food and analyse its nutritional content.",
        "NSPhotoLibraryUsageDescription": "Pawtchi uses your photo library to let you set your pet's profile picture.",
        "NSPhotoLibraryAddUsageDescription": "Pawtchi may save scanned food images to your photo library.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "splash": {
        "image": "./assets/images/splash-icon.png",
        "imageWidth": 240,
        "resizeMode": "contain",
        "backgroundColor": "#FFFF00"
      }
    },
    "android": {
      "package": "com.pawtchi.app",
      "versionCode": 25,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFFF00",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#FFFF00",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#FFFF00"
        }
      ],
      [
        "react-native-fbsdk-next",
        {
          "appID": "26757552720610335",
          "clientToken": "79543e30f2777f4f916072581d297285",
          "displayName": "Pawtchi",
          "scheme": "fb26757552720610335",
          "advertiserIDCollectionEnabled": true,
          "autoLogAppEventsEnabled": true,
          "isAutoInitEnabled": true,
          "iosUserTrackingPermission": "This identifier will be used to deliver personalized ads to you."
        }
      ],
      "expo-tracking-transparency",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "41552d8e-7b06-463c-a6d8-2a9c97461071"
      }
    }
  }
}
